# Copy to /opt/website/.env on the server and fill in. Never commit the real file.
PROXMOX_API_URL=https://<proxmox-host>:8006
PROXMOX_API_TOKEN=<user>@pve!<token-name>=<token-secret>
# Only needed while the API uses Proxmox's self-signed certificate:
# the output of `base64 -w0 /etc/pve/pve-root-ca.pem` on the Proxmox host.
PROXMOX_CA_CERT_B64=
