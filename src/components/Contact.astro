---
import Todo from './Todo.astro';
import { profile } from '../data/profile';
---

<section id="contact" class="section" aria-labelledby="contact-heading">
	<div class="wrap">
		<h2 id="contact-heading">Contact</h2>

		<dl class="contact">
			<div class="contact__row">
				<dt>Email</dt>
				<dd><a href={`mailto:${profile.email}`}>{profile.email}</a></dd>
			</div>
			<div class="contact__row">
				<dt>GitHub</dt>
				<dd><a href={profile.github.url} rel="me">{profile.github.label}</a></dd>
			</div>
			<div class="contact__row">
				<dt>LinkedIn</dt>
				<dd>
					{
						profile.linkedin.url ? (
							<a href={profile.linkedin.url} rel="me noopener noreferrer">
								{profile.linkedin.url.replace(/^https?:\/\/(www\.)?/, '')}
							</a>
						) : (
							<Todo>{profile.linkedin.todo}</Todo>
						)
					}
				</dd>
			</div>
		</dl>
	</div>
</section>
