---
import Todo from './Todo.astro';
import { experience } from '../data/profile';
---

<section id="experience" class="section" aria-labelledby="experience-heading">
	<div class="wrap">
		<h2 id="experience-heading">Experience</h2>

		<div class="stack">
			{
				experience.map((job) => (
					<article class="card">
						<header class="card__header">
							<h3>{job.employer}</h3>
							{job.todo && <Todo>{job.todo}</Todo>}
						</header>
						<ol class="roles" aria-label={`Roles at ${job.employer}, most recent first`}>
							{job.roles.map((role) => (
								<li class="roles__item">
									{role.title}
									{role.current && <span class="badge badge--earned">Current</span>}
								</li>
							))}
						</ol>
						{job.highlights.map((highlight) => (
							<p class="card__note">{highlight}</p>
						))}
					</article>
				))
			}
		</div>
	</div>
</section>
