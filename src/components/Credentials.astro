---
import Todo from './Todo.astro';
import { education, certifications, certificationsInProgress } from '../data/profile';
---

<section id="credentials" class="section" aria-labelledby="credentials-heading">
	<div class="wrap">
		<h2 id="credentials-heading">Credentials</h2>

		<div class="grid grid--two">
			<div>
				<h3>Certifications</h3>
				<ul class="list">
					{
						certifications.map((cert) => (
							<li class="list__item">
								<span class="list__title">{cert.name}</span>
								<span class="list__meta">
									<span class="badge badge--earned">Earned</span>
									{cert.verifyUrl ? (
										<a href={cert.verifyUrl} rel="noopener noreferrer">
											Verify<span class="visually-hidden"> {cert.name}</span>
										</a>
									) : (
										<Todo>Credly verification link</Todo>
									)}
								</span>
							</li>
						))
					}
					{
						certificationsInProgress.map((cert) => (
							<li class="list__item">
								<span class="list__title">{cert.name}</span>
								<span class="list__meta">
									<span class="badge badge--progress">In progress</span>
									Expected {cert.expected}
								</span>
							</li>
						))
					}
				</ul>
			</div>

			<div>
				<h3>Education</h3>
				<ul class="list">
					{
						education.map((entry) => (
							<li class="list__item">
								<span class="list__title">{entry.degree}</span>
								<span class="list__meta">
									{entry.school}
									{entry.completed ? (
										<>, {entry.completed}</>
									) : (
										<>
											<span class="badge badge--progress">In progress</span>
											{entry.expected ? <>Expected {entry.expected}</> : <Todo>{entry.todo}</Todo>}
										</>
									)}
								</span>
							</li>
						))
					}
				</ul>
			</div>
		</div>
	</div>
</section>
