---
import { profile, education, certifications, certificationsInProgress } from '../data/profile';

const earnedDegrees = education.filter((entry) => entry.completed);
---

<section class="hero" aria-labelledby="hero-heading">
	<div class="wrap">
		<h1 id="hero-heading">{profile.name}</h1>
		<p class="hero__role">
			{profile.role} <span class="hero__at">at {profile.employer}</span>
		</p>
		<p class="hero__focus">{profile.focus.join(' · ')}</p>

		<ul class="chips" aria-label="Credentials at a glance">
			{certifications.map((cert) => <li class="chip">{cert.short}</li>)}
			{
				earnedDegrees.map((entry) => (
					<li class="chip">
						{entry.short}, {entry.completed}
					</li>
				))
			}
			{
				certificationsInProgress.map((cert) => (
					<li class="chip chip--progress">
						{cert.name} <span class="chip__note">in progress, expected {cert.expected}</span>
					</li>
				))
			}
		</ul>

		<p class="hero__actions">
			<a class="button" href={`mailto:${profile.email}`}>{profile.email}</a>
			<a class="button button--quiet" href={profile.github.url} rel="me">GitHub</a>
		</p>
	</div>
</section>
